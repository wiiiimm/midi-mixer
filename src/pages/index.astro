---
import Meta from '../components/Meta.astro';
import {
  AppToast,
  BusyOverlay,
  InstrumentPickerDialog,
  MetronomePanel,
  RehearsalToolbar,
  ScoreViewport,
  SidebarDrawer,
  SoundCheckPiano,
  SplashScreen,
  TrackMixer,
  TransportBar,
  TuningForkPanel,
} from '../components';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <Meta
      title="midi-mixer · Rehearsal Studio"
      description="Rehearse your part in the browser: mix and solo MIDI tracks, follow an engraved score with note or sol-fa labels, loop bars, and sound-check with a piano, metronome and tuning fork."
    />
    <title>midi-mixer · Rehearsal Studio</title>
    <link rel="stylesheet" href="style.css" />
    <link rel="stylesheet" href="studio.css" />
  </head>
  <body>
    <SplashScreen />
    <SidebarDrawer />
    <main>
      <TransportBar />
      <RehearsalToolbar />
      <input id="seek" type="range" min="0" step=".01" value="0" aria-label="Playback position" />
      <div class="workspace">
        <div class="lanes">
          <TrackMixer />
          <ScoreViewport />
        </div>
        <output id="status" role="status"></output>
      </div>
      <SoundCheckPiano />
      <BusyOverlay />
    </main>
    <AppToast />
    <MetronomePanel />
    <TuningForkPanel />
    <InstrumentPickerDialog />
    <script is:inline src="repertoire.js"></script>
    <script is:inline src="loading.js"></script>
    <script is:inline src="floating.js"></script>
    <script is:inline src="sampler.js"></script>
    <script is:inline src="midi.js"></script>
    <script is:inline src="clefs.js"></script>
    <script is:inline src="tick.js"></script>
    <script is:inline src="player.js"></script>
    <script is:inline src="piano.js"></script>
    <script is:inline src="rehearsal-tools.js"></script>
    <script is:inline src="layout.js"></script>
    <script is:inline src="pwa.js"></script>
  </body>
</html>

<script>
  import '../scripts/engraved-score.js';
</script>
