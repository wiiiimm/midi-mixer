---
import Meta from '../components/Meta.astro';
import AppToast from '../components/studio/AppToast.astro';
import BusyOverlay from '../components/studio/BusyOverlay.astro';
import InstrumentPickerDialog from '../components/studio/InstrumentPickerDialog.astro';
import MetronomePanel from '../components/studio/MetronomePanel.astro';
import RehearsalToolbar from '../components/studio/RehearsalToolbar.astro';
import ScoreViewport from '../components/studio/ScoreViewport.astro';
import SidebarDrawer from '../components/studio/SidebarDrawer.astro';
import SoundCheckPiano from '../components/studio/SoundCheckPiano.astro';
import SplashScreen from '../components/studio/SplashScreen.astro';
import TrackMixer from '../components/studio/TrackMixer.astro';
import TransportBar from '../components/studio/TransportBar.astro';
import TuningForkPanel from '../components/studio/TuningForkPanel.astro';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <Meta title="midi-mixer · Rehearsal Studio" description="A browser-based MIDI rehearsal studio for singers and a cappella groups. Follow the score, solo your vocal part, then sing it against the other parts. Slow down and loop tricky passages." />
  <title>midi-mixer · Rehearsal Studio</title>
  <link rel="stylesheet" href="style.css">
  <link rel="stylesheet" href="studio.css">
</head>
<body>
<SplashScreen />
<SidebarDrawer />
<main>
  <TransportBar />
  <RehearsalToolbar />
  <input id="seek" type="range" min="0" step=".01" value="0" aria-label="Playback position">
  <div class="workspace">
    <div class="lanes">
      <TrackMixer />
      <ScoreViewport />
    </div>
    <output id="status" role="status"></output>
  </div>
  <SoundCheckPiano />
  <BusyOverlay />
</main>
<AppToast />
<MetronomePanel />
<TuningForkPanel />
<InstrumentPickerDialog />
</body>
</html>

<script>
  import '../scripts/main';
</script>
