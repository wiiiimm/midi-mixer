---
// Note editing controls, shown under the toolbar while Edit mode is on (see scripts/studio/editor.ts).

// The note value palette, shortest first, with the number keys other score editors use.
const values = [
  {beats: .25, name: 'Semiquaver', key: '3', flags: 2, open: false, stem: true},
  {beats: .5, name: 'Quaver', key: '4', flags: 1, open: false, stem: true},
  {beats: 1, name: 'Crotchet', key: '5', flags: 0, open: false, stem: true},
  {beats: 2, name: 'Minim', key: '6', flags: 0, open: true, stem: true},
  {beats: 4, name: 'Semibreve', key: '7', flags: 0, open: true, stem: false},
];
---
  <div id="editBar" class="edit-bar" hidden>
    <div class="edit-tools" role="toolbar" aria-label="Edit notes">
      <div class="edit-group">
        <button id="editInput" type="button" aria-pressed="false" title="Note input (N): tap a staff, or play the piano, to add notes" aria-label="Note input"><svg class="tool-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true" focusable="false"><ellipse cx="8" cy="17.5" rx="4.3" ry="3.1" transform="rotate(-20 8 17.5)" fill="currentColor" stroke="none" /><path d="M11.9 16.5V5M17.5 3.5v7M14 7h7" /></svg> <span class="label">Note input</span></button>
        <div id="editValues" class="edit-values" role="radiogroup" aria-label="Note value">
          {values.map(value => (
            <button type="button" role="radio" aria-checked={value.beats === 1 ? 'true' : 'false'} data-beats={value.beats} data-name={value.name.toLowerCase()} title={value.name + ' (' + value.key + ')'} aria-label={value.name}>
              <svg class="note-glyph" viewBox="0 0 16 24" aria-hidden="true" focusable="false">
                <ellipse cx="6" cy={value.stem ? 19 : 13} rx={value.open ? 3.9 : 4.4} ry={value.open ? 2.7 : 3.1} transform={'rotate(-20 6 ' + (value.stem ? 19 : 13) + ')'} fill={value.open ? 'none' : 'currentColor'} stroke="currentColor" stroke-width={value.open ? 1.5 : 0} />
                {value.stem && <path d="M9.9 18.2V3.5" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />}
                {value.flags > 0 && <path d="M9.9 3.5c.4 3.6 4.9 4 3.9 8.6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />}
                {value.flags > 1 && <path d="M9.9 7.7c.4 3.6 4.9 4 3.9 8.6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />}
              </svg>
            </button>
          ))}
        </div>
        <button id="editDot" type="button" aria-pressed="false" title="Dotted note value (.)" aria-label="Dotted"><svg class="note-glyph" viewBox="0 0 16 24" aria-hidden="true" focusable="false"><circle cx="8" cy="17" r="2.4" fill="currentColor" /></svg></button>
      </div>
      <span class="edit-divider" aria-hidden="true"></span>
      <div class="edit-group">
        <button id="editDown" type="button" title="Flatten: lower the selected note a semitone (Shift ↓)" aria-label="Flatten (lower a semitone)" disabled>♭</button>
        <button id="editUp" type="button" title="Sharpen: raise the selected note a semitone (Shift ↑)" aria-label="Sharpen (raise a semitone)" disabled>♯</button>
        <button id="editLink" type="button" aria-pressed="false" title="Tie or slur the selected note to another: the same pitch makes a tie, a different pitch a slur. You can also drag from one note to the other." aria-label="Tie or slur" disabled><svg class="tool-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M3 15c4.5-8 13.5-8 18 0" /></svg> <span class="label">Tie / Slur</span></button>
        <button id="editUnlink" type="button" title="Remove the selected note’s ties and slurs" aria-label="Remove tie or slur" disabled><svg class="tool-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M3 15c4.5-8 13.5-8 18 0M7 20 17 4" /></svg> <span class="label">Remove tie / slur</span></button>
        <button id="editDelete" type="button" title="Delete the selected note (Delete)" aria-label="Delete" disabled><svg class="tool-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 7h16M9.5 7V4.5h5V7M6.5 7l1 13h9l1-13M10 11v5.5M14 11v5.5" /></svg> <span class="label">Delete</span></button>
        <span class="edit-divider" aria-hidden="true"></span>
        <button id="editUndo" type="button" title="Undo (Ctrl/⌘ Z)" aria-label="Undo" disabled>↶ <span class="label">Undo</span></button>
        <button id="editRedo" type="button" title="Redo (Shift Ctrl/⌘ Z)" aria-label="Redo" disabled>↷ <span class="label">Redo</span></button>
        <span class="edit-divider" aria-hidden="true"></span>
        <details id="editMenu" class="edit-menu">
          <summary title="Reset, save or download this song" aria-label="Song: reset, save or download"><span aria-hidden="true">⋯</span> <span class="label">Song</span></summary>
          <div class="edit-menu-items">
            <button id="editSaveAs" type="button" title="Save the song as it is now as a new song in your playlist">Save as new song…</button>
            <button id="editDownload" type="button" title="Download the song as it is now as a MIDI file">Download .mid</button>
            <button id="editReset" type="button" title="Go back to the song’s original MIDI file" disabled>Reset to original</button>
          </div>
        </details>
      </div>
    </div>
    <p id="editHint" class="edit-hint" aria-live="polite"></p>
  </div>
  <div id="editCurve" class="edit-curve" aria-hidden="true" hidden><svg><path /></svg></div>
  <div id="editDrag" class="edit-drag" aria-hidden="true" hidden><span class="edit-drag-line"></span><span class="edit-drag-label"></span><span class="edit-loupe"><svg viewBox="0 0 132 104"></svg><span class="edit-loupe-name"></span></span></div>
  <div id="editGhost" class="edit-ghost" aria-hidden="true" hidden><span class="edit-ghost-ledgers"></span><span class="edit-ghost-head"></span><span class="edit-ghost-label"></span></div>
