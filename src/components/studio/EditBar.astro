---
// Note editing controls, shown under the toolbar while Edit mode is on (see scripts/studio/editor.ts).
---
  <div id="editBar" class="edit-bar" hidden>
    <div class="edit-tools" role="toolbar" aria-label="Edit notes">
      <label>Length <select id="editLength" aria-label="Length of new notes"><option value="4">Whole</option><option value="3">Dotted half</option><option value="2">Half</option><option value="1.5">Dotted quarter</option><option value="1" selected>Quarter</option><option value="0.75">Dotted eighth</option><option value="0.5">Eighth</option><option value="0.25">Sixteenth</option></select></label>
      <span class="edit-divider" aria-hidden="true"></span>
      <button id="editDown" type="button" title="Lower the selected note a semitone" aria-label="Lower a semitone" disabled>♭</button>
      <button id="editUp" type="button" title="Raise the selected note a semitone" aria-label="Raise a semitone" disabled>♯</button>
      <button id="editLink" type="button" aria-pressed="false" title="Link the selected note to another: the same pitch ties, a different pitch slurs" disabled>⌒ Link</button>
      <button id="editUnlink" type="button" title="Remove the selected note’s ties and slurs" disabled>Unlink</button>
      <button id="editDelete" type="button" title="Delete the selected note (Delete key)" aria-label="Delete" disabled><span aria-hidden="true">✕</span> <span class="label">Delete</span></button>
      <span class="edit-divider" aria-hidden="true"></span>
      <button id="editUndo" type="button" title="Undo (Ctrl/⌘ Z)" aria-label="Undo" disabled>↶ <span class="label">Undo</span></button>
      <button id="editRedo" type="button" title="Redo (Shift Ctrl/⌘ Z)" aria-label="Redo" disabled>↷ <span class="label">Redo</span></button>
      <button id="editReset" type="button" title="Go back to the song’s original MIDI file" aria-label="Reset to original" disabled>⟲ <span class="label">Reset to original</span></button>
    </div>
    <p id="editHint" class="edit-hint" aria-live="polite"></p>
  </div>
