---
// Per-track mixer. Rows are rendered by the mixer module; data-mobile-home moves it into the Mix tab on phones.
---
    <section class="strip" data-mobile-home="mix"><h2>Track mixer</h2>
      <div class="vocal-tools" role="group" aria-labelledby="vocalSoundsLabel">
        <span id="vocalSoundsLabel">Vocal sounds</span>
        <button id="resetSounds" type="button" disabled>Reset sounds</button>
        <button id="voiceOohs" type="button" aria-pressed="false" disabled>Oohs</button>
        <button id="choirAahs" type="button" aria-pressed="false" disabled>Aahs</button>
        <button id="vocalsByPart" type="button" aria-pressed="false" title="Oohs for upper voices, Aahs for lower voices" disabled>By part</button>
      </div>
      <div class="mix-tools"><label><input id="all" type="checkbox"> All tracks</label><button id="reset">Reset mix</button><button id="group" disabled>Mute selected</button><button id="solosel" disabled>Solo selected</button></div>
      <table><tbody id="rows"></tbody></table></section>
