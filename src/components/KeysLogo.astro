---
// App mark: five piano keys seen from a front-top angle, so a press reads as the key going down.
// `play` = "loop" (splash), "hover" (brand: plays on demand) or omitted (static).
const { play, class: className = '' } = Astro.props;
const back = 7, front = 29, depth = 4.5, mid = 24, persp = .8;
const at = (x: number, y: number) => (mid + (x - mid) * (persp + (1 - persp) * (y - back) / (front - back))).toFixed(2);
const quad = (x0: number, x1: number, y0: number, y1: number) => `${at(x0, y0)},${y0} ${at(x1, y0)},${y0} ${at(x1, y1)},${y1} ${at(x0, y1)},${y1}`;
const whites = [0, 1, 2, 3, 4].map(i => ({ i, x0: 4 + 8 * i + .4, x1: 12 + 8 * i - .4 }));
const blackEnd = 20;
const blacks = [1, 2, 4].map(j => ({ i: j - .5, x0: 4 + 8 * j - 2.6, x1: 4 + 8 * j + 2.6 }));
const id = `kl-${play ?? 'static'}`;
---
<svg class:list={['keys-logo', className, play && `keys-${play}`]} viewBox="0 0 48 40" role="img" aria-label="midi-mixer">
  <defs>
    <linearGradient id={`${id}-w`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#d8d8de" /><stop offset="1" stop-color="#ffffff" /></linearGradient>
    <linearGradient id={`${id}-b`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#1a1a1c" /><stop offset="1" stop-color="#3a3a3e" /></linearGradient>
  </defs>
  <polygon class="bed" points={quad(3, 45, back - 1.5, front + depth + 1)} />
  {whites.map(k => (
    <g class="key white" style={`--i:${k.i}`}>
      <polygon class="front" points={quad(k.x0, k.x1, front, front + depth)} />
      <polygon class="top" points={quad(k.x0, k.x1, back, front)} fill={`url(#${id}-w)`} />
      <polygon class="lit" points={quad(k.x0, k.x1, back, front)} />
    </g>
  ))}
  {blacks.map(k => (
    <g class="key black" style={`--i:${k.i}`}>
      <polygon class="front" points={quad(k.x0, k.x1, blackEnd, blackEnd + 2.6)} />
      <polygon class="top" points={quad(k.x0, k.x1, back, blackEnd)} fill={`url(#${id}-b)`} />
      <polygon class="lit" points={quad(k.x0, k.x1, back, blackEnd)} />
    </g>
  ))}
</svg>
